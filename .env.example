# Copy this file to .env and fill in your values.
# Never commit .env to version control.

OPENAI_API_KEY=your_openai_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

DATABASE_URL=postgresql://postgres:your_password@localhost:5433/smart_banking_project
AGENTIC_URL=postgresql://readonlyuser:your_readonly_password@localhost:5433/smart_banking_project

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT="smart-bank"
