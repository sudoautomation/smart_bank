# .env — Smart-Bank
# Secrets only. Never commit this file to version control.
# Copy this file to .env and fill in your values.

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Cohere ────────────────────────────────────────────────────────────────────
COHERE_API_KEY=...

# ── Postgres ──────────────────────────────────────────────────────────────────
